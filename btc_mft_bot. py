import urllib.request, urllib.parse, json, time, os

TOKEN = os.environ.get("BOT_TOKEN")
CHAT_ID = os.environ.get("CHAT_ID")

def send(msg):
    url = f"https://api.telegram.org/bot{TOKEN}/sendMessage"
    data = urllib.parse.urlencode({"chat_id": CHAT_ID, "text": msg}).encode()
    urllib.request.urlopen(urllib.request.Request(url, data=data))
    print("Alert sent!", flush=True)

def get_candles(interval, range_):
    url = f"https://query2.finance.yahoo.com/v8/finance/chart/BTC-USD?range={range_}&interval={interval}"
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    data = json.loads(urllib.request.urlopen(req, timeout=20).read().decode('utf-8'))
    q = data['chart']['result'][0]['indicators']['quote'][0]
    candles=[]
    for i in range(len(q['close'])):
        if q['close'][i] is not None:
            candles.append((q['high'][i], q['low'][i], q['close'][i]))
    return candles

def get_atr(candles, idx):
    trs=[]
    for j in range(max(1, idx-13), idx+1):
        tr = max(candles[j][0]-candles[j][1], abs(candles[j][0]-candles[j-1][2]), abs(candles[j][1]-candles[j-1][2]))
        trs.append(tr)
    return sum(trs)/len(trs)

def check():
    m30 = get_candles("30m","5d")
    m30_closes = [x[2] for x in m30]
    m30_avg = sum(m30_closes[-21:-1])/20
    m30_trend = "UP" if m30_closes[-1] > m30_avg else "DOWN"
    m15 = get_candles("15m","5d")
    closes = [x[2] for x in m15]
    highs = [x[0] for x in m15]
    lows = [x[1] for x in m15]
    last = closes[-1]
    avg20 = sum(closes[-21:-1])/20
    rh = max(highs[-21:-1])
    rl = min(lows[-21:-1])
    atr = get_atr(m15, len(m15)-1)
    print(f"M30: {m30_trend} | Price: ${last:,.2f}", flush=True)
    if m30_trend=="UP" and last>avg20 and last>rh:
        send(f"🚀 MTF SIGNAL - LONG\nM30: UP ✅\nM15 BOS UP: ${last:,.2f} broke ${rh:,.2f}\nWait M5 RETEST to ${rh:,.2f}\nEntry: Retest | SL: ${rh-atr:,.2f} | TP: ${rh+atr*1.5:,.2f}\nRisk: 0.5%")
    elif m30_trend=="DOWN" and last<avg20 and last<rl:
        send(f"🔻 MTF SIGNAL - SHORT\nM30: DOWN ✅\nM15 BOS DOWN: ${last:,.2f} broke ${rl:,.2f}\nWait M5 RETEST to ${rl:,.2f}\nEntry: Retest | SL: ${rl+atr:,.2f} | TP: ${rl-atr*1.5:,.2f}\nRisk: 0.5%")
    else:
        print("No MTF setup", flush=True)

print("MTF Bot started", flush=True)
send("✅ BTC MTF BOT ONLINE ON RENDER!\nM30 + M15 + M5 Retest | Backtest +27R")
while True:
    try:
        check()
    except Exception as e:
        print("Error:", e, flush=True)
    time.sleep(900)
